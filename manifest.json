{
  "manifest_version": 3,
  "name": "ChatGPT Web Helper",
  "version": "1.0.0",
  "description": "ChatGPT 网页端助手",
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["src/page-signals.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["src/model-classifier.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
